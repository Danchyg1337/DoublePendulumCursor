// Version metadata + application icon.
//
// Giving the executable a proper version resource and icon is the single most
// effective, no-cost way to reduce heuristic (…!ml) antivirus false positives
// on an unsigned binary -- metadata-less default-icon exes score much higher.
#include <windows.h>

// Icon id 101 == IDI_APPICON in Resource.h. Resolved relative to this .rc / the
// resource include path (see CMakeLists.txt / build.bat).
101 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,2,0,0
 PRODUCTVERSION 1,2,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS__WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Double-Pendulum Cursor project"
            VALUE "FileDescription",  "Double-Pendulum Cursor (animated system cursor)"
            VALUE "FileVersion",      "1.2.0.0"
            VALUE "InternalName",     "pendulum_cursor"
            VALUE "LegalCopyright",   "Open-source (MIT)"
            VALUE "OriginalFilename", "pendulum_cursor.exe"
            VALUE "ProductName",      "Double-Pendulum Cursor"
            VALUE "ProductVersion",   "1.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
